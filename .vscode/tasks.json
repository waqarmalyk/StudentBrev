{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Expo iOS",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"ios"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Typecheck",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}